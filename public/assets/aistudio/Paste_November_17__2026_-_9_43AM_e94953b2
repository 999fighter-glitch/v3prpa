  <script>
    const daysOfWeek = ['Ahad', 'Isnin', 'Selasa', 'Rabu', 'Khamis', 'Jumaat', 'Sabtu'];
    const shiftOptions = [
      { value: '', label: '-- Pilih Status / Syif --' },
      { value: 'CR', label: 'CR' },
      { value: 'CG', label: 'CG' },
      { value: 'HKA OFF', label: 'HKA OFF' },
      { value: 'HK OFF', label: 'HK OFF' },
      { value: 'PG SHJ', label: 'PG SHJ' },
      { value: 'PT SHJ', label: 'PT SHJ' },
      { value: 'KURSUS', label: 'KURSUS' },
      { value: 'M.TEAM', label: 'M.TEAM' },
      { value: 'MESYUARAT', label: 'MESYUARAT' },
      { value: 'LAIN-LAIN', label: 'LAIN-LAIN' }
    ];

    // Global Config & Default State
    let appConfig = {
      startDate: "2026-12-01",
      endDate: "2026-12-15",
      closingDate: "2026-12-31",
      forceStatus: "OPEN",
      svName: "En. Ravi",
      recordSpreadsheetUrl: "https://docs.google.com/spreadsheets/d/1ibZUZIs6vFiwDVhNNa1G_K9Fz4oRmoIgtoGsJg3vp6c/edit?gid=379069437#gid=379069437",
      logoUrl: "https://lh3.googleusercontent.com/d/1C9KN3ncJTrifXlaIP7zgW380zlEb1Kle=w500"
    };

    let generatedDateColumns = [];

    window.addEventListener('DOMContentLoaded', () => {
      populateRosterPeriods();
      fetchServerConfig();
      setupEventListeners();
    });

    function populateRosterPeriods() {
      const selectEl = document.getElementById('rosterPeriodSelect');
      if (!selectEl) return;

      const monthNames = [
        'Januari', 'Februari', 'Mac', 'April', 'Mei', 'Jun',
        'Julai', 'Ogos', 'September', 'Oktober', 'November', 'Disember'
      ];

      // Generate intervals from Disember 2026 (year 2026, month 11) to Disember 2027 (year 2027, month 11)
      const periods = [];
      for (let year = 2026; year <= 2027; year++) {
        const startMonth = (year === 2026) ? 11 : 0;
        const endMonth = 11;
        for (let m = startMonth; m <= endMonth; m++) {
          const mStr = String(m + 1).padStart(2, '0');
          const lastDay = new Date(year, m + 1, 0).getDate(); // 28, 30, or 31 accurately

          // Interval 1: 1 - 15
          const s1 = `${year}-${mStr}-01`;
          const e1 = `${year}-${mStr}-15`;
          periods.push({
            value: `${s1}|${e1}`,
            label: `${monthNames[m]} ${year} (01/${mStr}/${year} – 15/${mStr}/${year})`
          });

          // Interval 2: 16 - end of month (28/30/31)
          const s2 = `${year}-${mStr}-16`;
          const e2 = `${year}-${mStr}-${String(lastDay).padStart(2, '0')}`;
          periods.push({
            value: `${s2}|${e2}`,
            label: `${monthNames[m]} ${year} (16/${mStr}/${year} – ${lastDay}/${mStr}/${year})`
          });
        }
      }

      selectEl.innerHTML = periods.map(p => `<option value="${p.value}">${p.label}</option>`).join('');
      syncPeriodDropdownWithConfig();
    }

    function syncPeriodDropdownWithConfig() {
      const selectEl = document.getElementById('rosterPeriodSelect');
      if (!selectEl) return;
      const targetVal = `${appConfig.startDate}|${appConfig.endDate}`;
      const exists = Array.from(selectEl.options).some(opt => opt.value === targetVal);
      if (exists) {
        selectEl.value = targetVal;
      }
    }

    function fetchServerConfig() {
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler(res => {
            if (res && res.recordSpreadsheetUrl) {
              appConfig = Object.assign({}, appConfig, res);
            }
            applyConfigToUI();
            evaluateFormStatus();
            buildDateShiftRows();
          })
          .withFailureHandler(() => {
            applyConfigToUI();
            evaluateFormStatus();
            buildDateShiftRows();
          })
          .doGet({ parameter: { action: "getConfig" } });
      } else {
        applyConfigToUI();
        evaluateFormStatus();
        buildDateShiftRows();
      }
    }

    function applyConfigToUI() {
      if (appConfig.recordSpreadsheetUrl) {
        const linkBtn = document.getElementById('recordSheetLinkBtn');
        if (linkBtn) linkBtn.href = appConfig.recordSpreadsheetUrl;
        const bannerLink = document.getElementById('bannerSheetPreviewLink');
        if (bannerLink) bannerLink.href = appConfig.recordSpreadsheetUrl;
      }
      if (appConfig.logoUrl) {
        const logoImg = document.getElementById('appLogoImg');
        if (logoImg) logoImg.src = appConfig.logoUrl;
      }
      syncPeriodDropdownWithConfig();
      document.getElementById('displayTempohText').textContent = formatDateDisplay(appConfig.startDate) + " - " + formatDateDisplay(appConfig.endDate);
      document.getElementById('displaySvText').textContent = appConfig.svName;
    }

    function evaluateFormStatus() {
      const today = new Date().toISOString().split('T')[0];
      let isOpen = true;
      let reason = "";

      if (appConfig.forceStatus === "OPEN") {
        isOpen = true;
      } else if (appConfig.forceStatus === "CLOSED") {
        isOpen = false;
        reason = "Borang ditutup secara manual oleh pentadbir sistem.";
      } else {
        if (appConfig.closingDate && today > appConfig.closingDate) {
          isOpen = false;
          reason = "Tarikh tutup permohonan (" + formatDateDisplay(appConfig.closingDate) + ") telah tamat.";
        }
      }

      const closedNotice = document.getElementById('formClosedNotice');
      const activeForm = document.getElementById('activeFormContainer');
      const noticeReason = document.getElementById('closedNoticeReason');

      if (!isOpen) {
        if (closedNotice) closedNotice.classList.remove('hidden');
        if (activeForm) activeForm.classList.add('hidden');
        if (noticeReason) noticeReason.textContent = reason || "Tempoh permohonan telah ditutup.";
      } else {
        if (closedNotice) closedNotice.classList.add('hidden');
        if (activeForm) activeForm.classList.remove('hidden');
      }
    }

    function buildDateShiftRows() {
      const container = document.getElementById('dynamicDateFieldsContainer');
      if (!container) return;
      container.innerHTML = "";
      generatedDateColumns = [];

      const startParts = (appConfig.startDate || "2026-12-01").split('-');
      const endParts = (appConfig.endDate || "2026-12-15").split('-');
      const start = new Date(Number(startParts[0]), Number(startParts[1]) - 1, Number(startParts[2]));
      const end = new Date(Number(endParts[0]), Number(endParts[1]) - 1, Number(endParts[2]));

      let curr = new Date(start);
      while (curr <= end) {
        const dateStr = formatDateDisplayIso(curr);
        const dayName = daysOfWeek[curr.getDay()];
        const fullColTitle = dateStr + " (" + dayName + ")";
        generatedDateColumns.push(fullColTitle);

        const optionsHtml = shiftOptions.map(opt => `<option value="${opt.value}">${opt.label}</option>`).join('');

        const rowDiv = document.createElement('div');
        rowDiv.className = "p-3 rounded-xl border border-slate-200 bg-white space-y-2";
        rowDiv.innerHTML = `
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <span class="text-xs font-bold text-slate-800">${fullColTitle}</span>
            <select class="shift-select text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-300 bg-slate-50 focus:ring-2 focus:ring-sky-500 focus:outline-none" data-date="${fullColTitle}">
              ${optionsHtml}
            </select>
          </div>
          <div class="conditional-date-box hidden pt-1">
            <label class="block text-[11px] font-semibold text-sky-700 mb-1">Pilih Tarikh Pilihan / Gantian:</label>
            <input type="date" class="conditional-date-input w-full text-xs px-3 py-1.5 rounded-lg border border-sky-300 bg-sky-50/40 focus:ring-1 focus:ring-sky-500 focus:outline-none">
          </div>
          <div class="conditional-input-box hidden pt-1">
            <input type="text" placeholder="Nyatakan catatan / nama kursus..." class="conditional-val-input w-full text-xs px-3 py-1.5 rounded-lg border border-slate-300 bg-slate-50 focus:ring-1 focus:ring-sky-500 focus:outline-none">
          </div>
        `;

        const selectEl = rowDiv.querySelector('.shift-select');
        const condDateBox = rowDiv.querySelector('.conditional-date-box');
        const condDateInput = rowDiv.querySelector('.conditional-date-input');
        const condBox = rowDiv.querySelector('.conditional-input-box');
        const condValInput = rowDiv.querySelector('.conditional-val-input');

        selectEl.addEventListener('change', (e) => {
          const val = e.target.value;
          if (val === "CG" || val === "HKA OFF" || val === "HK OFF") {
            condDateBox.classList.remove('hidden');
            condBox.classList.add('hidden');
            condValInput.value = "";
          } else if (val === "KURSUS" || val === "LAIN-LAIN") {
            condBox.classList.remove('hidden');
            condDateBox.classList.add('hidden');
            condDateInput.value = "";
          } else {
            condDateBox.classList.add('hidden');
            condBox.classList.add('hidden');
            condDateInput.value = "";
            condValInput.value = "";
          }
        });

        container.appendChild(rowDiv);
        curr.setDate(curr.getDate() + 1);
      }
    }

    function setupEventListeners() {
      // Front-end Roster Period Selector listener
      const rosterPeriodSelect = document.getElementById('rosterPeriodSelect');
      if (rosterPeriodSelect) {
        rosterPeriodSelect.addEventListener('change', (e) => {
          const val = e.target.value;
          if (val && val.includes('|')) {
            const parts = val.split('|');
            appConfig.startDate = parts[0];
            appConfig.endDate = parts[1];
            const formattedRange = formatDateDisplay(appConfig.startDate) + " - " + formatDateDisplay(appConfig.endDate);
            document.getElementById('displayTempohText').textContent = formattedRange;
            buildDateShiftRows();
            showNotification(
              "Pengesahan Tempoh Tugasan",
              "Anda telah memilih interval tarikh tugasan: " + formattedRange + ". Sila pastikan anda menanda pengesahan peringatan sebelum meneruskan permohonan.",
              "success",
              false
            );
          }
        });
      }

      // Step 1 Proceed Button
      const proceedBtn = document.getElementById('proceedToFormBtn');
      if (proceedBtn) {
        proceedBtn.addEventListener('click', () => {
          const checks = document.querySelectorAll('.warning-check');
          let allChecked = true;
          checks.forEach(chk => {
            if (!chk.checked) allChecked = false;
          });

          const step1Alert = document.getElementById('step1Alert');
          if (!allChecked) {
            if (step1Alert) step1Alert.classList.remove('hidden');
            return;
          }
          if (step1Alert) step1Alert.classList.add('hidden');

          document.getElementById('step1Container').classList.add('hidden');
          const mainForm = document.getElementById('mainApplicationForm');
          mainForm.classList.remove('hidden');
          const nameSelect = document.getElementById('namaPemohon');
          if (nameSelect) nameSelect.focus();
        });
      }

      // Demo Mode: Force Activate Form (Top Header & Closed Notice)
      const forceActivateFormHandler = () => {
        appConfig.forceStatus = "OPEN";
        evaluateFormStatus();
        const successBanner = document.getElementById('submissionSuccessBanner');
        if (successBanner) successBanner.classList.add('hidden');
        const activeForm = document.getElementById('activeFormContainer');
        if (activeForm) activeForm.classList.remove('hidden');
        showNotification("Mod Demo Aktif", "Borang permohonan telah diaktifkan secara paksa untuk tujuan pengujian demo.", "success", false);
      };

      const demoForceActivateBtn = document.getElementById('demoForceActivateBtn');
      if (demoForceActivateBtn) {
        demoForceActivateBtn.addEventListener('click', forceActivateFormHandler);
      }

      const closedNoticeDemoForceBtn = document.getElementById('closedNoticeDemoForceBtn');
      if (closedNoticeDemoForceBtn) {
        closedNoticeDemoForceBtn.addEventListener('click', forceActivateFormHandler);
      }

      // Demo Mode: Auto-Tick All Checklist & Open Form
      const demoAutoTickOpenBtn = document.getElementById('demoAutoTickOpenBtn');
      if (demoAutoTickOpenBtn) {
        demoAutoTickOpenBtn.addEventListener('click', () => {
          const checks = document.querySelectorAll('.warning-check');
          checks.forEach(chk => {
            chk.checked = true;
          });
          const step1Alert = document.getElementById('step1Alert');
          if (step1Alert) step1Alert.classList.add('hidden');

          document.getElementById('step1Container').classList.add('hidden');
          const mainForm = document.getElementById('mainApplicationForm');
          mainForm.classList.remove('hidden');
          const nameSelect = document.getElementById('namaPemohon');
          if (nameSelect) nameSelect.focus();
        });
      }

      // Admin Modal Open / Close
      const openAdminBtn = document.getElementById('openAdminModalBtn');
      const closeAdminBtn = document.getElementById('closeAdminModalBtn');
      const adminModal = document.getElementById('adminModal');

      if (openAdminBtn) {
        openAdminBtn.addEventListener('click', () => {
          adminModal.classList.remove('hidden');
          adminModal.classList.add('flex');
          checkGoogleAuthSession();
        });
      }

      if (closeAdminBtn) {
        closeAdminBtn.addEventListener('click', () => {
          adminModal.classList.add('hidden');
          adminModal.classList.remove('flex');
        });
      }

      // Google Auth Login Button in Admin Modal
      const authLoginBtn = document.getElementById('googleAuthLoginBtn');
      if (authLoginBtn) {
        authLoginBtn.addEventListener('click', () => {
          const errEl = document.getElementById('googleLoginError');
          if (errEl) errEl.classList.add('hidden');

          if (typeof google !== 'undefined' && google.script && google.script.run) {
            try {
              google.script.run
                .withSuccessHandler(res => {
                  if (res && res.email) {
                    showAdminDashboard(res.name, res.email);
                  } else {
                    promptDirectAdminLogin();
                  }
                })
                .withFailureHandler(() => {
                  promptDirectAdminLogin();
                })
                .getGoogleUserSession();
            } catch (e) {
              promptDirectAdminLogin();
            }
          } else {
            promptDirectAdminLogin();
          }
        });
      }

      // Save Admin Config Button
      const saveConfigBtn = document.getElementById('saveAdminConfigBtn');
      if (saveConfigBtn) {
        saveConfigBtn.addEventListener('click', () => {
          const newConfig = {
            startDate: document.getElementById('adminStartDate').value || appConfig.startDate,
            endDate: document.getElementById('adminEndDate').value || appConfig.endDate,
            closingDate: document.getElementById('adminClosingDate').value || appConfig.closingDate,
            forceStatus: document.getElementById('adminForceStatus').value || "AUTO",
            svName: document.getElementById('adminSvName').value || "En. Ravi",
            recordSpreadsheetUrl: document.getElementById('adminRecordSheetUrl').value || appConfig.recordSpreadsheetUrl,
            logoUrl: document.getElementById('adminLogoUrl').value || appConfig.logoUrl
          };

          if (typeof google !== 'undefined' && google.script && google.script.run) {
            google.script.run
              .withSuccessHandler(() => {
                appConfig = newConfig;
                applyConfigToUI();
                evaluateFormStatus();
                buildDateShiftRows();
                adminModal.classList.add('hidden');
                adminModal.classList.remove('flex');
                showNotification("Berjaya", "Tetapan admin dan pautan Google Sheets telah berjaya dikemaskini!", "success");
              })
              .withFailureHandler(err => {
                showNotification("Ralat", "Gagal menyimpan tetapan: " + err, "error");
              })
              .doPost({ postData: { contents: JSON.stringify({ action: "saveConfig", config: newConfig }) } });
          } else {
            appConfig = newConfig;
            applyConfigToUI();
            evaluateFormStatus();
            buildDateShiftRows();
            adminModal.classList.add('hidden');
            adminModal.classList.remove('flex');
            showNotification("Berjaya", "Tetapan tempatan dikemaskini.", "success");
          }
        });
      }

      // Form Submit Button
      const mainForm = document.getElementById('mainApplicationForm');
      if (mainForm) {
        mainForm.addEventListener('submit', (e) => {
          e.preventDefault();
          submitApplicationData(false);
        });
      }

      // WhatsApp Summary Button
      const waBtn = document.getElementById('whatsappSummaryBtn');
      if (waBtn) {
        waBtn.addEventListener('click', () => {
          submitApplicationData(true);
        });
      }

      // Close Notification Modal Button
      const closeNotifBtn = document.getElementById('closeNotifBtn');
      if (closeNotifBtn) {
        closeNotifBtn.addEventListener('click', () => {
          document.getElementById('notificationModal').classList.add('hidden');
          document.getElementById('notificationModal').classList.remove('flex');
        });
      }

      // Custom System Admin Email Modal Buttons
      const cancelCustomEmailBtn = document.getElementById('cancelCustomAdminEmailBtn');
      const confirmCustomEmailBtn = document.getElementById('confirmCustomAdminEmailBtn');
      const customEmailModal = document.getElementById('customAdminEmailModal');
      if (cancelCustomEmailBtn) {
        cancelCustomEmailBtn.addEventListener('click', () => {
          customEmailModal.classList.add('hidden');
          customEmailModal.classList.remove('flex');
        });
      }
      if (confirmCustomEmailBtn) {
        confirmCustomEmailBtn.addEventListener('click', () => {
          const val = document.getElementById('customAdminEmailField').value.trim();
          const errEl = document.getElementById('customAdminEmailError');
          if (val && val.includes('@')) {
            errEl.classList.add('hidden');
            customEmailModal.classList.add('hidden');
            customEmailModal.classList.remove('flex');
            const name = val.split('@')[0];
            const formattedName = name.charAt(0).toUpperCase() + name.slice(1);
            showAdminDashboard(formattedName, val);
          } else {
            errEl.textContent = "Sila masukkan alamat emel Google yang sah.";
            errEl.classList.remove('hidden');
          }
        });
      }
    }

    function checkGoogleAuthSession() {
      const loginPrompt = document.getElementById('adminLoginPrompt');
      const adminDashboard = document.getElementById('adminDashboardView');
      const errorEl = document.getElementById('googleLoginError');

      if (!loginPrompt || !adminDashboard) return;

      loginPrompt.classList.remove('hidden');
      adminDashboard.classList.add('hidden');
      if (errorEl) errorEl.classList.add('hidden');

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler(res => {
            if (res && res.email) {
              showAdminDashboard(res.name, res.email);
            }
          })
          .withFailureHandler(() => {})
          .getGoogleUserSession();
      }
    }

    function promptDirectAdminLogin() {
      const customModal = document.getElementById('customAdminEmailModal');
      const field = document.getElementById('customAdminEmailField');
      const errEl = document.getElementById('customAdminEmailError');
      if (field) field.value = "";
      if (errEl) errEl.classList.add('hidden');
      if (customModal) {
        customModal.classList.remove('hidden');
        customModal.classList.add('flex');
        if (field) field.focus();
      }
    }

    function showAdminDashboard(name, email) {
      document.getElementById('adminLoginPrompt').classList.add('hidden');
      document.getElementById('adminDashboardView').classList.remove('hidden');
      document.getElementById('adminUserName').textContent = name || "Admin Rasmi";
      document.getElementById('adminUserEmail').textContent = email;
      const avatarEl = document.getElementById('adminUserAvatar');
      if (avatarEl) avatarEl.textContent = (name || "A").charAt(0).toUpperCase();

      document.getElementById('adminStartDate').value = appConfig.startDate;
      document.getElementById('adminEndDate').value = appConfig.endDate;
      document.getElementById('adminClosingDate').value = appConfig.closingDate;
      document.getElementById('adminForceStatus').value = appConfig.forceStatus;
      document.getElementById('adminSvName').value = appConfig.svName;
      document.getElementById('adminRecordSheetUrl').value = appConfig.recordSpreadsheetUrl;
      document.getElementById('adminLogoUrl').value = appConfig.logoUrl;
    }

    function submitApplicationData(openWhatsapp) {
      const email = document.getElementById('emailInput').value.trim();
      const phone = document.getElementById('phoneInput').value.trim();
      const name = document.getElementById('namaPemohon').value.trim().toUpperCase();
      const suratKelulusan = document.getElementById('suratKelulusanInput').value.trim();
      const sendEmailCopy = document.getElementById('sendEmailCopyCheck').checked;

      if (!email || !phone || !name) {
        showNotification("Perhatian", "Sila lengkapkan emel, no. telefon, dan pilih nama pemohon daripada senarai.", "error", false);
        return;
      }

      const rows = document.querySelectorAll('#dynamicDateFieldsContainer > div');
      let orderedShifts = [];
      let summaryLines = [];

      rows.forEach(row => {
        const sel = row.querySelector('.shift-select');
        const condDateInput = row.querySelector('.conditional-date-input');
        const condInput = row.querySelector('.conditional-val-input');
        const dateKey = sel.getAttribute('data-date');
        let val = sel.value;
        let waVal = val;

        if (val && condDateInput && condDateInput.value.trim() !== "") {
          const formattedPickedDate = formatDateDisplay(condDateInput.value.trim());
          // Simpan dalam satu kolum dengan baris baharu (newline)
          val += "\nTarikh Pilihan: " + formattedPickedDate;
          waVal += " (Tarikh Pilihan: " + formattedPickedDate + ")";
        } else if (val && condInput && condInput.value.trim() !== "") {
          val += "\n(" + condInput.value.trim() + ")";
          waVal += " (" + condInput.value.trim() + ")";
        }

        orderedShifts.push(val);
        if (val) {
          summaryLines.push("• " + dateKey + ": " + waVal);
        }
      });

      const tempohTugasan = formatDateDisplay(appConfig.startDate) + " - " + formatDateDisplay(appConfig.endDate);

      const payload = {
        action: "submitApplication",
        timestamp: new Date().toISOString(),
        email: email,
        noTelefon: phone,
        namaPemohon: name,
        tempohTugasan: tempohTugasan,
        dateColumns: generatedDateColumns,
        orderedShifts: orderedShifts,
        suratKelulusan: suratKelulusan,
        sendEmailCopy: sendEmailCopy,
        recordSpreadsheetUrl: appConfig.recordSpreadsheetUrl
      };

      if (openWhatsapp) {
        let waText = "*PERMOHONAN JADUAL TUGAS PPP U5*\n\n" +
                     "*Tempoh:* " + tempohTugasan + "\n" +
                     "*Nama:* " + name + "\n" +
                     "*Tel:* " + phone + "\n" +
                     "*Emel:* " + email + "\n";
        if (suratKelulusan) {
          waText += "*Surat Kelulusan:* " + suratKelulusan + "\n";
        }
        waText += "\n*Pilihan Syif Harian:*\n" + (summaryLines.length > 0 ? summaryLines.join("\n") : "- Tiada syif khusus dipilih");
        
        const encoded = encodeURIComponent(waText);
        window.open("https://api.whatsapp.com/send?phone=60100000000&text=" + encoded, "_blank");
      }

      const handleSuccessRecord = (customMessage) => {
        // Tutup borang selepas berjaya dihantar dan paparkan banner pengesahan
        const activeFormContainer = document.getElementById('activeFormContainer');
        if (activeFormContainer) activeFormContainer.classList.add('hidden');
        const successBanner = document.getElementById('submissionSuccessBanner');
        const bannerLink = document.getElementById('bannerSheetPreviewLink');
        if (bannerLink) bannerLink.href = appConfig.recordSpreadsheetUrl;
        if (successBanner) successBanner.classList.remove('hidden');

        showNotification("Permohonan Berjaya!", customMessage || "Permohonan anda telah berjaya direkod.", "success", true);
      };

      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler(res => {
            if (res && res.status === "success") {
              handleSuccessRecord(res.message);
            } else {
              showNotification("Ralat", "Gagal menyimpan: " + (res.message || "Sila cuba lagi"), "error", false);
            }
          })
          .withFailureHandler(err => {
            showNotification("Ralat Rangkaian", "Gagal menghubungi pelayan: " + err, "error", false);
          })
          .doPost({ postData: { contents: JSON.stringify(payload) } });
      } else {
        handleSuccessRecord();
      }
    }

    function showNotification(title, message, type, showSheetPreview) {
      const modal = document.getElementById('notificationModal');
      document.getElementById('notifTitle').textContent = title;
      document.getElementById('notifMessage').textContent = message;
      
      const previewBox = document.getElementById('notifSheetPreviewBox');
      const previewLink = document.getElementById('notifSheetPreviewLink');
      if (previewBox && previewLink) {
        if (showSheetPreview) {
          previewLink.href = appConfig.recordSpreadsheetUrl;
          previewBox.classList.remove('hidden');
        } else {
          previewBox.classList.add('hidden');
        }
      }

      const iconWrapper = document.getElementById('notifIconWrapper');
      if (type === "error") {
        iconWrapper.className = "w-14 h-14 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto";
        iconWrapper.innerHTML = `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
      } else {
        iconWrapper.className = "w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto";
        iconWrapper.innerHTML = `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function formatDateDisplay(isoStr) {
      if (!isoStr) return "";
      const parts = isoStr.split('-');
      if (parts.length === 3) {
        return parts[2] + "/" + parts[1] + "/" + parts[0];
      }
      return isoStr;
    }

    function formatDateDisplayIso(dateObj) {
      const d = String(dateObj.getDate()).padStart(2, '0');
      const m = String(dateObj.getMonth() + 1).padStart(2, '0');
      const y = dateObj.getFullYear();
      return d + "/" + m + "/" + y;
    }
  </script>
