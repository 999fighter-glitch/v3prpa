  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-full flex flex-col justify-between selection:bg-sky-500 selection:text-white">

  <!-- Main Container <--VERSION 2.4.2-->
  <div class="max-w-4xl mx-auto w-full p-4 sm:p-6 lg:p-8 flex-grow">
    
    <!-- Top Header & Logo Banner -->
    <header class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6 text-center relative overflow-hidden">
      <!-- Admin Panel Trigger Button -->
      <button type="button" id="openAdminModalBtn" class="absolute top-4 right-4 inline-flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3 py-2 rounded-xl transition-all shadow-sm">
        <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path></svg>
        Admin Panel
      </button>

      <!-- LOGO / BANNER LINK REFERENCE REMARK -->
      <!-- Original Logo Sizing & Shape with Full Top Banner Fit -->
      <div class="mb-4 flex justify-center items-center">
        <img id="appLogoImg" src="https://lh3.googleusercontent.com/d/1C9KN3ncJTrifXlaIP7zgW380zlEb1Kle=w500" alt="Logo Rasmi PPP U5" class="max-h-24 w-auto object-contain rounded-lg shadow-sm" onerror="this.src='https://placehold.co/400x120/0288d1/ffffff?text=PPP+U5+ROSTER';">
      </div>

      <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">SISTEM PERMOHONAN JADUAL TUGAS PPP U5</h1>
      <div class="mt-1 flex items-center justify-center gap-2">
        <p class="text-xs sm:text-sm text-slate-500">Klinik Kesihatan / Fasiliti Kesihatan U5</p>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-sky-100 text-sky-800 border border-sky-200">Versi 2.4 (Edisi Roster 2026/2027)</span>
      </div>

      <!-- SHEET REFERENCE LINK REMARK -->
      <!-- Default Spreadsheet Reference Link -->
      <div class="mt-3 flex flex-wrap justify-center items-center gap-2">
        <a id="recordSheetLinkBtn" href="https://docs.google.com/spreadsheets/d/1ibZUZIs6vFiwDVhNNa1G_K9Fz4oRmoIgtoGsJg3vp6c/edit?gid=379069437#gid=379069437" target="_blank" class="inline-flex items-center gap-2 text-xs font-medium text-sky-700 bg-sky-50 hover:bg-sky-100 px-3 py-1.5 rounded-lg transition-colors border border-sky-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          Buka Pautan Google Sheet Rekod Rasmi
        </a>
        <!-- Demo Mode: Force Activate Form Button -->
        <button type="button" id="demoForceActivateBtn" class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-800 bg-amber-50 hover:bg-amber-100 px-3 py-1.5 rounded-lg transition-colors border border-amber-300 shadow-sm">
          <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Mod Demo: Paksa Aktifkan Borang
        </button>
      </div>
    </header>

    <!-- Form Closed / Status Notice Container -->
    <div id="formClosedNotice" class="hidden bg-red-50 border border-red-200 rounded-2xl p-8 text-center space-y-4 mb-6 shadow-sm">
      <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
      <h2 class="text-xl font-bold text-red-900">Borang Permohonan Telah Ditutup</h2>
      <p id="closedNoticeReason" class="text-sm text-red-700 max-w-md mx-auto">Tempoh permohonan jadual bertugas bagi tarikh yang ditetapkan telah ditutup atau tarikh akhir telah berlalu.</p>
      <div class="pt-2">
        <button type="button" id="closedNoticeDemoForceBtn" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold py-2.5 px-5 rounded-xl text-xs sm:text-sm shadow-sm transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          Mod Demo: Paksa Buka Borang Sekarang
        </button>
      </div>
    </div>

    <!-- Post-Submission Success Confirmation Banner (Shown after form closes on submit) -->
    <div id="submissionSuccessBanner" class="hidden bg-emerald-50 border border-emerald-200 rounded-2xl p-8 text-center space-y-4 mb-6 shadow-sm">
      <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h2 class="text-xl font-bold text-emerald-900">Permohonan anda telah berjaya direkod</h2>
      <p class="text-sm text-emerald-700 max-w-md mx-auto">Rekod permohonan jadual tugas anda telah berjaya disimpan ke dalam sistem Google Sheets.</p>
      <div class="pt-2 flex flex-col sm:flex-row justify-center gap-3">
        <a id="bannerSheetPreviewLink" href="https://docs.google.com/spreadsheets/d/1ibZUZIs6vFiwDVhNNa1G_K9Fz4oRmoIgtoGsJg3vp6c/edit?gid=379069437#gid=379069437" target="_blank" class="inline-flex items-center justify-center gap-2 bg-sky-600 hover:bg-sky-700 text-white font-semibold py-2.5 px-5 rounded-xl text-xs sm:text-sm shadow-sm transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          Pratonton Rekod di Google Sheets
        </a>
      </div>
    </div>

    <!-- Active Form Wrapper -->
    <div id="activeFormContainer" class="space-y-6">

      <!-- Top Roster Period Selector & Active Duty Period Display (Before Acknowledgement) -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
        <div class="bg-sky-50/70 rounded-xl p-4 border border-sky-200 space-y-2.5">
          <div class="flex items-center justify-between">
            <label for="rosterPeriodSelect" class="block text-xs font-bold text-sky-900 uppercase tracking-wide">
              Pilihan Tempoh Roster Permohonan Tugas (Dis 2026 – Dis 2027) <span class="text-red-500">*</span>
            </label>
            <span class="text-[11px] font-semibold text-sky-700 bg-white px-2 py-0.5 rounded border border-sky-200">Interval Bulanan</span>
          </div>
          <select id="rosterPeriodSelect" class="w-full rounded-xl border border-sky-300 bg-white px-3.5 py-2.5 text-xs sm:text-sm font-semibold text-slate-800 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20">
            <!-- Dynamically populated with Dis 2026 - Dis 2027 (1-15 & 16-28/30/31) -->
          </select>
        </div>

        <!-- Dynamic Duty Period Display -->
        <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
          <div>
            <span class="text-xs font-bold text-slate-500 uppercase">Tempoh Tugasan Aktif:</span>
            <p id="displayTempohText" class="text-sm font-bold text-slate-800">01/12/2026 - 15/12/2026</p>
          </div>
          <div>
            <span class="text-xs font-bold text-slate-500 uppercase">Penyelia (SV) Incaj:</span>
            <p id="displaySvText" class="text-sm font-bold text-sky-700">En. Ravi</p>
          </div>
        </div>
      </div>

      <!-- Step 1: Acknowledgement / Peringatan Penting Checklist -->
      <div id="step1Container" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-600 bg-sky-50 px-2.5 py-1 rounded-md">Langkah 1 dari 2</span>
          <h2 class="text-lg font-bold text-slate-900 mt-2">Peringatan Penting & Syarat Permohonan</h2>
          <p class="text-xs text-slate-500 mt-0.5">Sila baca dan tandakan kesemua 5 peringatan di bawah untuk meneruskan permohonan.</p>
        </div>

        <div class="space-y-3.5">
          <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50/80 transition-all cursor-pointer">
            <input type="checkbox" class="warning-check mt-1 w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500">
            <span class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">1. Setiap permohonan tertakluk kepada kelulusan ketua fasiliti / penyelia bertugas.</span>
          </label>
          <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50/80 transition-all cursor-pointer">
            <input type="checkbox" class="warning-check mt-1 w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500">
            <span class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">2. Pertukaran syif wajib mendapat persetujuan pegawai pengganti sebelum dihantar.</span>
          </label>
          <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50/80 transition-all cursor-pointer">
            <input type="checkbox" class="warning-check mt-1 w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500">
            <span class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">3. Borang yang dihantar lewat dari tarikh tutup tidak akan dilayan.</span>
          </label>
          <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50/80 transition-all cursor-pointer">
            <input type="checkbox" class="warning-check mt-1 w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500">
            <span class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">4. Pastikan tarikh dan status syif harian diisi dengan tepat dan betul.</span>
          </label>
          <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 hover:bg-slate-50/80 transition-all cursor-pointer">
            <input type="checkbox" class="warning-check mt-1 w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500">
            <span class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">5. Segala maklumat yang diberikan adalah benar dan sahih.</span>
          </label>
        </div>

        <div id="step1Alert" class="hidden text-xs font-semibold text-amber-600 bg-amber-50 p-3 rounded-xl border border-amber-200">
          ⚠️ Sila tandakan kesemua 5 kotak peringatan di atas terlebih dahulu untuk membuka borang permohonan.
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <button type="button" id="proceedToFormBtn" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
            <span>Teruskan ke Borang Permohonan</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <!-- Demo Mode: Auto Tick All & Open Form Button -->
          <button type="button" id="demoAutoTickOpenBtn" class="bg-amber-500 hover:bg-amber-600 text-white font-semibold py-3.5 px-5 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Mod Demo: Auto-Tandakan &amp; Buka Borang</span>
          </button>
        </div>
      </div>

      <!-- Step 2: Main Application Form (Initially Hidden) -->
      <form id="mainApplicationForm" class="hidden bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-6">
        <div class="border-b border-slate-100 pb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md">Langkah 2 dari 2</span>
          <h2 class="text-lg font-bold text-slate-900 mt-2">Maklumat & Pilihan Syif Tugasan</h2>
          <p class="text-xs text-slate-500 mt-0.5">Sila lengkapkan butiran peribadi dan jadual harian anda di bawah.</p>
        </div>

        <!-- Personal Info Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Alamat Emel Rasmi</label>
            <input type="email" id="emailInput" required placeholder="nama@moh.gov.my" class="w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-sky-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">No. Telefon Bimbit</label>
            <input type="text" id="phoneInput" required placeholder="0123456789" class="w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-sky-500 focus:outline-none">
          </div>
        </div>

        <div>
          <label for="namaPemohon" class="block text-sm font-bold text-slate-800 mb-1">
            NAMA PEMOHON (SUSUNAN IKUT ABJAD) <span class="text-red-500">*</span>
          </label>
          <select id="namaPemohon" name="namaPemohon" required class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20">
            <option value="">-- Sila Pilih Nama --</option>
            <option value="ABD RAHMAN BIN ABD. AZIZ">ABD RAHMAN BIN ABD. AZIZ</option>
            <option value="AHMAD MUHAIMINZEE BIN ISMAIL">AHMAD MUHAIMINZEE BIN ISMAIL</option>
            <option value="AIMAN AIZUDDIN BIN MAZLAN">AIMAN AIZUDDIN BIN MAZLAN</option>
            <option value="CHE NORHISYAM BIN CHE HUSIN">CHE NORHISYAM BIN CHE HUSIN</option>
            <option value="KAMARUL EFENDI BIN RADZALI">KAMARUL EFENDI BIN RADZALI</option>
            <option value="MOHAMAD ZAFIR BIN ISA">MOHAMAD ZAFIR BIN ISA</option>
            <option value="MOHAMMAD HADI BIN ANUAR">MOHAMMAD HADI BIN ANUAR</option>
            <option value="MOHAMMAD ZULHAKIMI BIN MARUDING">MOHAMMAD ZULHAKIMI BIN MARUDING</option>
            <option value="MOHD AKMAL HADI BIN ZAKARIA">MOHD AKMAL HADI BIN ZAKARIA</option>
            <option value="MOHD AMIRUN BIN AHMAD">MOHD AMIRUN BIN AHMAD</option>
            <option value="MOHD IMRAN BIN MOHD NOR">MOHD IMRAN BIN MOHD NOR</option>
            <option value="MUHAMAD AZRI BIN AZIZ">MUHAMAD AZRI BIN AZIZ</option>
            <option value="MUHAMAD NABIL BIN OTHMAN">MUHAMAD NABIL BIN OTHMAN</option>
            <option value="MUHAMMAD HAZIM BIN NASARUDDIN">MUHAMMAD HAZIM BIN NASARUDDIN</option>
            <option value="MUHAMMAD SHAHRUL AZWAN BIN KAMARUDDIN">MUHAMMAD SHAHRUL AZWAN BIN KAMARUDDIN</option>
            <option value="MUHAMMAD SYAFIQ IZZAT BIN ZOLNALDI">MUHAMMAD SYAFIQ IZZAT BIN ZOLNALDI</option>
            <option value="WAN MOHD RIDZUAN BIN WAN BERAHIM">WAN MOHD RIDZUAN BIN WAN BERAHIM</option>
            <option value="ABDUL HAMIDULLAH BIN ABDUL MOMEN">ABDUL HAMIDULLAH BIN ABDUL MOMEN</option>
            <option value="ALIMMIN TAQUIDDIN BIN RUSLI">ALIMMIN TAQUIDDIN BIN RUSLI</option>
            <option value="MUHAMMAD NASIRUDDIN NAZMI BIN NAZARI">MUHAMMAD NASIRUDDIN NAZMI BIN NAZARI</option>
            <option value="MOHD NUR AL HAFIS BIN SAHDI">MOHD NUR AL HAFIS BIN SAHDI</option>
            <option value="FLORINA LOUIS">FLORINA LOUIS</option>
            <option value="MEDILITA MUNGGIANG">MEDILITA MUNGGIANG</option>
            <option value="AMIRUL AFANDI BIN MOHD KHAZAHIR">AMIRUL AFANDI BIN MOHD KHAZAHIR</option>
            <option value="MOHAMMAD AMIRRUDDIN BIN MOHAMAD ISA">MOHAMMAD AMIRRUDDIN BIN MOHAMAD ISA</option>
            <option value="VERSHANE STONE">VERSHANE STONE</option>
            <option value="NUR WAHIDATUN BALQIS BINTI MOHD YUSUFF">NUR WAHIDATUN BALQIS BINTI MOHD YUSUFF</option>
            <option value="BRANDON RYAN ANASTASIUS">BRANDON RYAN ANASTASIUS</option>
            <option value="MOHAMAD HASNAWIE HAIMAN BIN NORDIN">MOHAMAD HASNAWIE HAIMAN BIN NORDIN</option>
            <option value="MUHAMMAD DANIAL HAKIMI BIN SUFIAN">MUHAMMAD DANIAL HAKIMI BIN SUFIAN</option>
            <option value="MUHAMMAD HAFIZZAT AIMAN BIN MOHD YUNUS">MUHAMMAD HAFIZZAT AIMAN BIN MOHD YUNUS</option>
            <option value="SITI NURAISYAH BINTI MOHAMAD">SITI NURAISYAH BINTI MOHAMAD</option>
            <option value="NURUL SYAZWANI BINTI OSMAN">NURUL SYAZWANI BINTI OSMAN</option>
          </select>
        </div>

        <!-- Daily Dates & Shifts Container -->
        <div class="space-y-4">
          <h3 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-2">Pilihan Syif Tarikh Harian</h3>
          <div id="dynamicDateFieldsContainer" class="space-y-3 max-h-96 overflow-y-auto pr-1">
            <!-- Dynamically injected date rows -->
          </div>
        </div>

        <!-- Surat Kelulusan Upload / Link Field -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Pautan / Rujukan Surat Kelulusan (Jika Berkaitan)</label>
          <input type="text" id="suratKelulusanInput" placeholder="https://drive.google.com/... atau Cuti Diluluskan" class="w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-sky-500 focus:outline-none">
        </div>

        <!-- Email Copy Option -->
        <div class="flex items-center gap-3 pt-2">
          <input type="checkbox" id="sendEmailCopyCheck" class="w-4 h-4 text-sky-600 rounded border-slate-300 focus:ring-sky-500">
          <label for="sendEmailCopyCheck" class="text-xs sm:text-sm font-medium text-slate-700 cursor-pointer">Hantar salinan ringkasan permohonan ke emel saya.</label>
        </div>

        <!-- Submit & WhatsApp Actions -->
        <div class="pt-4 flex flex-col sm:flex-row gap-3">
          <button type="submit" id="submitFormBtn" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Hantar Permohonan & Simpan ke Sheets
